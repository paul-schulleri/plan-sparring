#!/usr/bin/env bash
# plan-sparring-review — hand the current plan to the sparring partner, print its objections,
# and record a receipt the gate can trust.
#
#   plan-sparring-review --epoch <dir>
#
# The plan is read from <dir>/plan.md, where the hook put it straight out of ExitPlanMode, so it
# never travels through a shell argument.
set -uo pipefail

PS_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$PS_HOME/lib/common.sh"

die() { printf 'plan-sparring: %s\n' "$1" >&2; exit 2; }

dir=""
while [ $# -gt 0 ]; do
  case "$1" in
    --epoch) [ $# -ge 2 ] || die "--epoch needs a directory"; dir="$2"; shift 2 ;;
    -h|--help) awk 'NR>1 && /^#/ {print; next} NR>1 {exit}' "$0"; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[ -n "$dir" ] || die "missing --epoch <dir>"
[ -d "$dir" ] || die "no such epoch: $dir (the planning round may have ended; call ExitPlanMode again)"
if [ ! -s "$dir/plan.md" ]; then
  pf=$(cat "$dir/planfile" 2>/dev/null || true)
  [ -n "$pf" ] && die "the captured plan in $dir is empty, and the plan file ($pf) could not be read either. Call ExitPlanMode once and run this again; if it stays empty, report it as a plugin bug."
  die "no plan captured in $dir yet - call ExitPlanMode once so the hook can capture the current draft, then run this again"
fi
command -v "$PS_BACKEND_BIN" >/dev/null 2>&1 || die "\"$PS_BACKEND_BIN\" not found on PATH"
# ps_num, not a digit filter of its own: `08` survives such a filter and is then FATAL inside the
# $(( )) of the deadline below - after the backend has been forked, so the runner dies without a
# digest and leaves the CLI orphaned. The message names PLAN_SPARRING_TIMEOUT because only a value
# someone set can fail here; the default 600 cannot.
PS_TIMEOUT=$(ps_num "$PS_TIMEOUT")
[ "$PS_TIMEOUT" -gt 0 ] || die "PLAN_SPARRING_TIMEOUT must be a whole number of seconds, 1 to 9999999, got: ${PLAN_SPARRING_TIMEOUT:-}"

# ps_num on the way in: junk in this file used to be a FATAL error here, inside fail_digest, so
# `die` never ran and the reason for the failure never reached the transcript at all.
ps_fail() { echo $(( $(ps_num "$(cat "$dir/fails" 2>/dev/null || true)") + 1 )) > "$dir/fails"; }

# Snapshot what we are about to review. If the epoch is recycled or the plan replaced while the
# backend is still thinking, the answer describes a plan that no longer exists and must not be
# turned into a receipt for the new one.
epoch_before=$(cat "$dir/id" 2>/dev/null || true)
sha_before=$(ps_sha "$dir/plan.md")
[ -n "$epoch_before" ] || die "epoch $dir has no id - it looks corrupt; call ExitPlanMode again to open a fresh round"

# Written by the hook alongside the plan, so a round that has a plan has an account whenever any
# is configured. Empty means no account was configured at all: the CLI keeps whichever home it
# would use on its own, which is what a single-login machine wants.
account=$(cat "$dir/account" 2>/dev/null || true)
home=""
if [ -n "$account" ]; then
  home=$(ps_account_home "$account") \
    || die "the account \"$account\" chosen for this round is not in PLAN_SPARRING_ACCOUNTS (any more). Call ExitPlanMode again and pick one that is."
  # Checked here, before the backend is forked: started against a directory that is not there,
  # the CLI would either fail with its own message or, worse, fall back to a different login.
  [ -d "$home" ] || die "the \"$account\" account points at $home, which does not exist. Fix PLAN_SPARRING_ACCOUNTS, or log that account in there."
fi

# One read of the previous receipt, and the exit status decides whether any of it counts.
# ps_num before the arithmetic: a round of "two", 1.5 or "08" in there is a fatal $(( )) error.
prev_fields=$(ps_receipt "$dir") || prev_fields=""
{ read -r _; read -r _; read -r prev_outcome; read -r prev_sha; read -r prev_round
  read -r prev_points; read -r prev_account; } <<< "$prev_fields"

# Same draft, same account: the round would come back saying nothing has changed. Same draft,
# DIFFERENT account is a different reviewer and a real round - and refusing it would deadlock
# against the gate, which denies a receipt from the account the user just switched away from.
if [ -n "$prev_sha" ] && [ "$prev_sha" = "$sha_before" ] && [ "$prev_account" = "$account" ]; then
  die "this is the same draft that was just reviewed, so a new round would come back saying nothing has changed. Editing the plan file is not enough: call ExitPlanMode again to hand the revised draft over, and you will be pointed back here."
fi

round=$(( $(ps_num "$prev_round") + 1 ))
# Written by the hook. Empty when the runner is started by hand, which reads as "spar" below -
# the more informative of the two, and wrong in no way the user can act on.
route=$(cat "$dir/route" 2>/dev/null || true)
thread=$(cat "$dir/thread" 2>/dev/null || true)

# A conversation lives in the account that started it, so a switch cannot resume into it. Dropping
# the id starts a fresh conversation, which is exactly what the new account needs.
if [ -n "$thread" ] && [ "$prev_account" != "$account" ]; then
  thread=""; : > "$dir/thread"
  printf 'plan-sparring: account changed, starting a fresh conversation.\n' >&2
fi

# resume runs in the CURRENT directory, so later rounds must start where round 1 did.
if [ "$round" -gt 1 ] && [ -s "$dir/cwd" ]; then cd "$(cat "$dir/cwd")" 2>/dev/null || true; else printf '%s' "$PWD" > "$dir/cwd"; fi
[ "$round" -gt 1 ] && [ -z "$thread" ] && printf 'plan-sparring: no thread id from the previous round, starting a fresh conversation.\n' >&2

if [ "$round" -eq 1 ]; then
  header="You are the sparring partner for a Claude Code implementation plan. Be adversarial, but
only about things that would actually hurt: data loss or corruption, a crash or hang, or the plan
plainly not doing what it says. Do NOT raise style, naming, structure, extra test coverage, or
\"the plan does not mention X\" unless the omission causes one of those three. Do not rewrite the
plan. A limitation the plan states openly and accepts - a narrowed scope, a named non-goal - is a
valid answer to an objection; do not insist it be implemented. The plan may carry a \"## Scope\" or
\"## Rebuttals\" section; treat both as answers, not as gaps. If nothing in those classes is left,
agree, even if you would have written it differently."
else
  header="This is round $round. Here is the plan revised after your previous objections. Say what
still does not hold, using the same threshold as before: data loss, crash or hang, or the plan
plainly not working. Check in particular whether the changes made since the last round broke
something that already worked - a fix for one objection regressing another path is the common
failure here. New wishes outside those classes do not belong. A limitation the plan states openly
and accepts is a valid answer. Where the plan rebuts a point you raised, either accept the rebuttal
or say concretely why it does not hold - do not restate the point unchanged. Judge what is left
against the plan's stated scope: if the remaining risk is implausible for what this plan covers,
agree. If nothing in those classes is left, agree."
fi
# The SUMMARY markers below are matched by ps_headlines() in lib/common.sh, anchored to a whole
# line. Change them here and you must change them there - deliberately not a shared variable: as an
# awk -v it would turn that fixed anchor into a dynamic regex.
prompt="$header

Answer in this shape, in this order:

SUMMARY BEGIN
- one line per point, at most five, each under 100 characters
SUMMARY END

then whatever detail you want, and your last non-empty line must be EXACTLY one of these two,
with nothing after it:
VERDICT: AGREED
VERDICT: OBJECTIONS

If you agree, use the summary block to say what you checked instead of listing objections.

--- PLAN ---
$(cat "$dir/plan.md")"

# The whole prompt goes as one argument; feeding this CLI on stdin is the documented way to make
# it hang before it even starts a session.
[ "${#prompt}" -lt 200000 ] || die "this plan is too large to send as one argument (${#prompt} bytes). Shorten it, or review it manually."

# --- THE SWAP POINT ----------------------------------------------------------
# The vendor PROTOCOL is these two functions and nothing else. Vendor identity - name, binary,
# model, effort - is configuration in lib/common.sh, because the hook needs PS_BACKEND_NAME for
# PS_LABEL_SPAR and never sources this file. A different vendor means rewriting the two functions:
#   ps_backend_run     prompt as one argument in, review into the -o file, last non-empty line
#                      exactly "VERDICT: AGREED" or "VERDICT: OBJECTIONS".
#   ps_backend_thread  the round's log in, the CLI's own conversation id on stdout, or nothing.
# `exec` matters: it replaces the background subshell with the CLI, so the pid we may have to kill
# is the CLI itself and not a parent that would leave it orphaned.
ps_backend_run() {
  local out="$1" log="$2"
  # Which variable carries the account is vendor protocol, so it lives here with the rest of it.
  # The export is safe because this function only ever runs in the background subshell.
  [ -z "$home" ] || export CODEX_HOME="$home"
  if [ "$round" -gt 1 ] && [ -n "$thread" ]; then
    exec "$PS_BACKEND_BIN" exec resume --skip-git-repo-check "$thread" -o "$out" "$prompt" </dev/null >"$log" 2>&1
  else
    exec "$PS_BACKEND_BIN" exec --skip-git-repo-check -C "$PWD" -m "$PS_MODEL" \
      -c model_reasoning_effort="$PS_EFFORT" -s read-only -o "$out" "$prompt" </dev/null >"$log" 2>&1
  fi
}
# Round 2+ should continue the same conversation, and the id's format belongs to the CLI - so
# reading it belongs here and not in the generic path. Empty output means "no thread": the runner
# then starts a fresh conversation and says so.
# The ^ anchor and head -1 are both load-bearing. The CLI writes its header BEFORE the prompt and
# then the prompt itself into the log - and the prompt contains the plan. A plan that so much as
# mentions the string "session id: <hex>" used to hand `tail -1` its own quoted id, and `resume`
# then died from round 2 on against a thread that never existed. The anchor drops the embedded
# matches; head -1 wins even for a plan whose own line starts that way, because the header is
# printed first.
ps_backend_thread() { grep -oE '^session id: [0-9a-fA-F-]{8,}' "$1" 2>/dev/null | head -1 | awk '{print $3}'; }
# -----------------------------------------------------------------------------

# Keep the draft we are about to review, so the next round can show what changed. Only the
# previous one is kept unless the user asked to keep the round - snapshots are full plan texts.
# The rm matters: cp can create the target and then fail part-way through (ENOSPC). A torso left
# behind is non-empty, so the next round would diff against it and print a WRONG delta instead of
# degrading to "delta unavailable".
snap="$dir/plan-$round.md"
cp "$dir/plan.md" "$snap" 2>/dev/null || { rm -f "$snap"; snap="$dir/plan.md"; }
prev="$dir/plan-$((round - 1)).md"
prev_points=$(ps_num "$prev_points")

# The outgoing half of the digest. A delta cannot prove objections were addressed, so this says
# "rechecking", never "addressed".
sent="sent   draft, $(ps_lines "$snap") lines"
if [ "$round" -gt 1 ]; then
  d=$(ps_delta "$prev" "$snap") && sent="$sent ($d since round $((round - 1)))" || sent="$sent (delta unavailable)"
  # Only after objections. When the previous round AGREED, the headlines are what the reviewer
  # says it checked, and calling those "previously highlighted points" invents open work.
  [ "$prev_points" -gt 0 ] && [ "$prev_outcome" != agreed ] && sent="$sent
       rechecking $prev_points previously highlighted point(s)"
fi

# There is no round 2 on the pass route, so do not print a budget the user cannot spend. The cap
# is written by the hook, the only side that can see how often the user chose to keep sparring;
# started by hand there is no such file, and the base budget is the honest answer.
cap=$(ps_num "$(cat "$dir/cap" 2>/dev/null || true)")
[ "$cap" -ge 1 ] || cap=$(ps_budget 0)
case "$route" in
  pass) where="single review pass" ;;
  *)    where="round $round/$cap" ;;
esac
# secs is set the moment the backend is done, before the first failure branch: on a timeout or a
# dead CLI the duration is the more interesting half of the digest. Initialised here because
# digest() is defined before the run and set -u would kill the caller mid-report.
secs=0
digest() {   # $1 = the "back" block, $2 = the "next" line
  printf '\n%s\n%s\n%s\nnext   %s\n' \
    "plan-sparring · $where · $PS_BACKEND_NAME${account:+ ($account)} $PS_MODEL $PS_EFFORT · ${secs}s" \
    "$sent" "$1" "$2"
}
# Failures used to print nothing but an error, which is exactly when the transcript went dark.
fail_digest() { digest "back   FAILED — $1" "$2"; ps_fail; die "$1"; }

out="$dir/review-$round.txt"; log="$dir/log-$round.txt"; rm -f "$out"
printf 'plan-sparring: round %s, asking %s%s (%s, effort %s, timeout %ss)...\n' "$round" "$PS_BACKEND_NAME" "${account:+ ($account)}" "$PS_MODEL" "$PS_EFFORT" "$PS_TIMEOUT" >&2

t0=$(date +%s)
ps_backend_run "$out" "$log" & pid=$!
trap 'kill -TERM "$pid" 2>/dev/null; exit 130' INT TERM HUP
deadline=$(( $(date +%s) + PS_TIMEOUT )); timed_out=0
while kill -0 "$pid" 2>/dev/null; do
  if [ "$(date +%s)" -ge "$deadline" ]; then
    kill -TERM "$pid" 2>/dev/null
    for _ in 1 2 3; do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    kill -KILL "$pid" 2>/dev/null; timed_out=1; break
  fi
  sleep 2
done
wait "$pid" 2>/dev/null; rc=$?
trap - INT TERM HUP
secs=$(( $(date +%s) - t0 ))

[ "$timed_out" -eq 1 ] && fail_digest "$PS_BACKEND_NAME did not answer within ${PS_TIMEOUT}s and was killed" "raise PLAN_SPARRING_TIMEOUT and run this again, or ask the user how to proceed"
[ "$rc" -ne 0 ] && { tail -5 "$log" 2>/dev/null >&2; fail_digest "$PS_BACKEND_NAME exited with status $rc" "check the error above, then run this again"; }
[ -s "$out" ] || fail_digest "$PS_BACKEND_NAME returned an empty review" "run this again; if it repeats, ask the user how to proceed"

# One verdict, as the final non-empty line, exactly as asked for. Anything else - a truncated
# answer, a service error printed as prose, a stray earlier VERDICT line - is not a review.
verdict=$(grep -v '^[[:space:]]*$' "$out" | tail -1 | tr -d '\r')
verdict="${verdict#"${verdict%%[![:space:]]*}"}"; verdict="${verdict%"${verdict##*[![:space:]]}"}"
case "$verdict" in
  "VERDICT: AGREED")     outcome=agreed ;;
  "VERDICT: OBJECTIONS") outcome=objections ;;
  *) fail_digest "$PS_BACKEND_NAME did not end with a verdict line (last line: ${verdict:-<empty>})" "run this again; if it repeats, ask the user how to proceed" ;;
esac

[ "$(cat "$dir/id" 2>/dev/null || true)" = "$epoch_before" ] || die "the planning round changed while $PS_BACKEND_NAME was working; no receipt was written. Call ExitPlanMode again and rerun this."
[ "$(ps_sha "$dir/plan.md")" = "$sha_before" ] || die "the plan changed while $PS_BACKEND_NAME was working; no receipt was written. Rerun this command to review the current plan."

[ -n "$thread" ] || { thread=$(ps_backend_thread "$log"); printf '%s' "$thread" > "$dir/thread"; }

points=$(ps_headlines "$out")

if ! { jq -n --arg e "$epoch_before" --arg b "$PS_BACKEND_NAME" --arg m "$PS_MODEL" \
        --argjson r "$round" --arg ih "$sha_before" --arg o "$outcome" \
        --arg hl "$points" --arg ac "$account" \
        '{epoch:$e, backend:$b, account:$ac, model:$m, round:$r, input_sha256:$ih, status:"ok",
          outcome:$o, headlines: ($hl | split("\n") | map(select(length > 0)))}' \
        > "$dir/receipt.json.tmp" && mv -f "$dir/receipt.json.tmp" "$dir/receipt.json"; }; then
  rm -f "$dir/receipt.json.tmp"; ps_fail
  die "the review came back but the receipt could not be written to $dir. Check disk space and permissions."
fi
echo 0 > "$dir/fails"
[ -n "${PLAN_SPARRING_KEEP:-}" ] || rm -f "$dir/plan-$((round - 2)).md" 2>/dev/null

# On the pass route the next ExitPlanMode opens the gate: nothing is handed over, so do not
# promise a revision round that will not happen.
if [ "$route" = pass ]; then
  nxt="work them into the plan, then call ExitPlanMode - the gate opens from there"
else
  nxt="work them into the plan, then call ExitPlanMode to hand the revision over"
fi
if [ "$outcome" = agreed ]; then
  back="back   AGREED"; nxt="call ExitPlanMode - it opens for this plan as it stands"
elif [ -n "$points" ]; then
  back="back   OBJECTIONS — $(printf '%s\n' "$points" | grep -c .) highlighted point(s)"
else
  # No count here: "0 highlighted point(s)" alongside a denial reads as "nothing to fix".
  back="back   OBJECTIONS — summary unavailable, see the full review below"
fi
[ -n "$points" ] && back="$back
$(printf '%s\n' "$points" | sed 's/^/       - /')"
digest "$back" "$nxt"
echo
echo "Relay the block above to the user as your status update, in the language of the conversation."
echo
echo "----- full review, round $round -----"
cat "$out"
[ -n "$(tail -c1 "$out")" ] && echo
exit 0
