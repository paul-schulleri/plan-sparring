#!/usr/bin/env bash
# plan-sparring-review — hand the current plan to the sparring partner, print its objections,
# and record a receipt the gate can trust.
#
#   plan-sparring-review --epoch <dir>
#
# The plan is read from <dir>/plan.md, where the hook put it straight out of ExitPlanMode, so it
# never travels through a shell argument.
set -uo pipefail

PS_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$PS_HOME/lib/common.sh"

die() { printf 'plan-sparring: %s\n' "$1" >&2; exit 2; }

dir=""
while [ $# -gt 0 ]; do
  case "$1" in
    --epoch) [ $# -ge 2 ] || die "--epoch needs a directory"; dir="$2"; shift 2 ;;
    -h|--help) awk 'NR>1 && /^#/ {print; next} NR>1 {exit}' "$0"; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[ -n "$dir" ] || die "missing --epoch <dir>"
[ -d "$dir" ] || die "no such epoch: $dir (the planning round may have ended; call ExitPlanMode again)"
if [ ! -s "$dir/plan.md" ]; then
  pf=$(cat "$dir/planfile" 2>/dev/null || true)
  [ -n "$pf" ] && die "the captured plan in $dir is empty, and the plan file ($pf) could not be read either. Call ExitPlanMode once and run this again; if it stays empty, report it as a plugin bug."
  die "no plan captured in $dir yet - call ExitPlanMode once so the hook can capture the current draft, then run this again"
fi
command -v "$PS_BACKEND_BIN" >/dev/null 2>&1 || die "\"$PS_BACKEND_BIN\" not found on PATH"
case "$PS_TIMEOUT" in ''|*[!0-9]*) die "PLAN_SPARRING_TIMEOUT must be a whole number of seconds, got: $PS_TIMEOUT" ;; esac
[ "$PS_TIMEOUT" -gt 0 ] || die "PLAN_SPARRING_TIMEOUT must be greater than 0"

ps_fail() { echo $(( $(cat "$dir/fails" 2>/dev/null || echo 0) + 1 )) > "$dir/fails"; }

# Snapshot what we are about to review. If the epoch is recycled or the plan replaced while the
# backend is still thinking, the answer describes a plan that no longer exists and must not be
# turned into a receipt for the new one.
epoch_before=$(cat "$dir/id" 2>/dev/null || true)
sha_before=$(ps_sha "$dir/plan.md")
[ -n "$epoch_before" ] || die "epoch $dir has no id - it looks corrupt; call ExitPlanMode again to open a fresh round"

prev_sha=$(jq -r '.input_sha256 // empty' "$dir/receipt.json" 2>/dev/null || true)
if [ -n "$prev_sha" ] && [ "$prev_sha" = "$(ps_sha "$dir/plan.md")" ]; then
  die "this is the same draft that was just reviewed, so a new round would come back saying nothing has changed. Editing the plan file is not enough: call ExitPlanMode again to hand the revised draft over, and you will be pointed back here."
fi

round=$(( $(jq -r '.round // 0' "$dir/receipt.json" 2>/dev/null || echo 0) + 1 ))
thread=$(cat "$dir/thread" 2>/dev/null || true)

# resume runs in the CURRENT directory, so later rounds must start where round 1 did.
if [ "$round" -gt 1 ] && [ -s "$dir/cwd" ]; then cd "$(cat "$dir/cwd")" 2>/dev/null || true; else printf '%s' "$PWD" > "$dir/cwd"; fi
[ "$round" -gt 1 ] && [ -z "$thread" ] && printf 'plan-sparring: no thread id from the previous round, starting a fresh conversation.\n' >&2

if [ "$round" -eq 1 ]; then
  header="You are the sparring partner for a Claude Code implementation plan. Be adversarial, but
only about things that would actually hurt: data loss or corruption, a crash or hang, or the plan
plainly not doing what it says. Do NOT raise style, naming, structure, extra test coverage, or
\"the plan does not mention X\" unless the omission causes one of those three. Do not rewrite the
plan. A limitation the plan states openly and accepts - a narrowed scope, a named non-goal - is a
valid answer to an objection; do not insist it be implemented. If nothing in those classes is left,
agree, even if you would have written it differently."
else
  header="This is round $round. Here is the plan revised after your previous objections. Say what
still does not hold, using the same threshold as before: data loss, crash or hang, or the plan
plainly not working. Check in particular whether the changes made since the last round broke
something that already worked - a fix for one objection regressing another path is the common
failure here. New wishes outside those classes do not belong. A limitation the plan states openly
and accepts is a valid answer. If nothing in those classes is left, agree."
fi
prompt="$header

Your last non-empty line must be EXACTLY one of these two, with nothing after it:
VERDICT: AGREED
VERDICT: OBJECTIONS

--- PLAN ---
$(cat "$dir/plan.md")"

# The whole prompt goes as one argument; feeding this CLI on stdin is the documented way to make
# it hang before it even starts a session.
[ "${#prompt}" -lt 200000 ] || die "this plan is too large to send as one argument (${#prompt} bytes). Shorten it, or review it manually."

# --- THE SWAP POINT ----------------------------------------------------------
# Everything vendor-specific is in this one function. A different vendor means rewriting it and
# nothing else: the contract around it is plain text in, review on stdout, VERDICT line at the end.
# `exec` matters: it replaces the background subshell with the CLI, so the pid we may have to kill
# is the CLI itself and not a parent that would leave it orphaned.
ps_backend_run() {
  local out="$1" log="$2"
  if [ "$round" -gt 1 ] && [ -n "$thread" ]; then
    exec "$PS_BACKEND_BIN" exec resume --skip-git-repo-check "$thread" -o "$out" "$prompt" </dev/null >"$log" 2>&1
  else
    exec "$PS_BACKEND_BIN" exec --skip-git-repo-check -C "$PWD" -m "$PS_MODEL" \
      -c model_reasoning_effort="$PS_EFFORT" -s read-only -o "$out" "$prompt" </dev/null >"$log" 2>&1
  fi
}
# -----------------------------------------------------------------------------

out="$dir/review-$round.txt"; log="$dir/log-$round.txt"; rm -f "$out"
printf 'plan-sparring: round %s, asking %s (%s, effort %s, timeout %ss)...\n' "$round" "$PS_BACKEND_NAME" "$PS_MODEL" "$PS_EFFORT" "$PS_TIMEOUT" >&2

ps_backend_run "$out" "$log" & pid=$!
trap 'kill -TERM "$pid" 2>/dev/null; exit 130' INT TERM HUP
deadline=$(( $(date +%s) + PS_TIMEOUT )); timed_out=0
while kill -0 "$pid" 2>/dev/null; do
  if [ "$(date +%s)" -ge "$deadline" ]; then
    kill -TERM "$pid" 2>/dev/null
    for _ in 1 2 3; do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    kill -KILL "$pid" 2>/dev/null; timed_out=1; break
  fi
  sleep 2
done
wait "$pid" 2>/dev/null; rc=$?
trap - INT TERM HUP

[ "$timed_out" -eq 1 ] && { ps_fail; die "$PS_BACKEND_NAME did not answer within ${PS_TIMEOUT}s and was killed. Raise PLAN_SPARRING_TIMEOUT, or ask the user how to proceed."; }
[ "$rc" -ne 0 ] && { ps_fail; tail -5 "$log" 2>/dev/null >&2; die "$PS_BACKEND_NAME exited with status $rc (see above). No receipt was written."; }
[ -s "$out" ] || { ps_fail; die "$PS_BACKEND_NAME returned an empty review. No receipt was written."; }

# One verdict, as the final non-empty line, exactly as asked for. Anything else - a truncated
# answer, a service error printed as prose, a stray earlier VERDICT line - is not a review.
verdict=$(grep -v '^[[:space:]]*$' "$out" | tail -1 | tr -d '\r')
verdict="${verdict#"${verdict%%[![:space:]]*}"}"; verdict="${verdict%"${verdict##*[![:space:]]}"}"
case "$verdict" in
  "VERDICT: AGREED")     outcome=agreed ;;
  "VERDICT: OBJECTIONS") outcome=objections ;;
  *) ps_fail; die "$PS_BACKEND_NAME did not end with a verdict line (last line was: ${verdict:-<empty>}). Treating this as a failed review; no receipt was written." ;;
esac

# The epoch must still be the one we reviewed.
[ "$(cat "$dir/id" 2>/dev/null || true)" = "$epoch_before" ] || die "the planning round changed while $PS_BACKEND_NAME was working; no receipt was written. Call ExitPlanMode again and rerun this."
[ "$(ps_sha "$dir/plan.md")" = "$sha_before" ] || die "the plan changed while $PS_BACKEND_NAME was working; no receipt was written. Rerun this command to review the current plan."

[ -n "$thread" ] || { thread=$(grep -oE 'session id: [0-9a-fA-F-]{8,}' "$log" 2>/dev/null | tail -1 | awk '{print $3}'); printf '%s' "$thread" > "$dir/thread"; }

if ! { jq -n --arg e "$epoch_before" --arg b "$PS_BACKEND_NAME" --arg m "$PS_MODEL" \
        --argjson r "$round" --arg ih "$sha_before" --arg o "$outcome" \
        '{epoch:$e, backend:$b, model:$m, round:$r, input_sha256:$ih, status:"ok", outcome:$o}' \
        > "$dir/receipt.json.tmp" && mv -f "$dir/receipt.json.tmp" "$dir/receipt.json"; }; then
  rm -f "$dir/receipt.json.tmp"; ps_fail
  die "the review came back but the receipt could not be written to $dir. Check disk space and permissions."
fi
echo 0 > "$dir/fails"

echo "===== $PS_BACKEND_NAME, round $round — outcome: $outcome ====="
cat "$out"
[ -n "$(tail -c1 "$out")" ] && echo   # the review may end without a newline
echo "====="
if [ "$outcome" = agreed ]; then
  echo "Receipt written. ExitPlanMode is open for this plan as it stands - change it and the agreement no longer applies."
else
  echo "Receipt written, but objections stand. Work through them, then: on the \"$PS_LABEL_PASS\" route call ExitPlanMode; on the \"$PS_LABEL_SPAR\" route run this command again for the next round."
fi
exit 0
