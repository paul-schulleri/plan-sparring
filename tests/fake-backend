#!/usr/bin/env bash
# Stand-in for the real CLI so the tests need no network, no auth and no rate limit.
# FAKE_MODE: agreed | objections | garbage | trailing | fail | empty | hang | nosummary | many
#            | prosemarker | longutf8 | twoids | home
set -uo pipefail
out=""; prev=""
for a in "$@"; do [ "$prev" = "-o" ] && out="$a"; prev="$a"; done
echo "session id: 0123abcd-dead-beef-0000-000000000001"
case "${FAKE_MODE:-agreed}" in
  fail)  echo "boom" >&2; exit 3 ;;
  empty) : > "$out"; exit 0 ;;
  hang)  exec sleep "${PS_HANG_SECS:-987}" ;;   # duration doubles as this run's pgrep marker
  garbage)  printf 'service unavailable\n' > "$out" ;;
  # An early agreement followed by a real objection: only the LAST line may count.
  trailing) printf 'VERDICT: AGREED\nActually, no.\nVERDICT: OBJECTIONS\n' > "$out" ;;
  nosummary) printf 'Just prose, no summary block.\nVERDICT: OBJECTIONS\n' > "$out" ;;
  many) { echo "SUMMARY BEGIN"; for i in 1 2 3 4 5 6 7 8; do echo "- point $i"; done; echo "SUMMARY END"; echo "detail - with a bullet"; echo "VERDICT: OBJECTIONS"; } > "$out" ;;
  # Names both markers in prose before the real block: an unanchored parser closes on this line.
  prosemarker) printf 'I will put them between SUMMARY BEGIN and SUMMARY END below:\nSUMMARY BEGIN\n- the real point\nSUMMARY END\nVERDICT: OBJECTIONS\n' > "$out" ;;
  # One headline well past the byte bound, in a language that has more than ASCII in it.
  longutf8) { echo "SUMMARY BEGIN"; printf -- '- Pruefung der Datei:%s und dann noch etwas Text hinterher\n' "$(printf 'ä%.0s' $(seq 1 90))"; echo "SUMMARY END"; echo "VERDICT: OBJECTIONS"; } > "$out" ;;
  # The real CLI echoes the prompt into the log after its own header, so a plan that mentions a
  # session id puts a second, WRONG one further down. Only the header line counts.
  twoids) echo 'tests/fake-backend:8:echo "session id: 0000dead-beef-0000-0000-000000000002"'
          printf 'SUMMARY BEGIN\n- x\nSUMMARY END\nVERDICT: OBJECTIONS\n' > "$out" ;;
  # Reports back which home it was started with, so the account wiring can be asserted end to end.
  home) printf 'SUMMARY BEGIN\n- home=%s\nSUMMARY END\nVERDICT: OBJECTIONS\n' "${CODEX_HOME:-none}" > "$out" ;;
  objections) printf 'SUMMARY BEGIN\n- dry-run reports every file as skipped\n- category dir may be a symlink\nSUMMARY END\nDetail here.\nVERDICT: OBJECTIONS\n' > "$out" ;;
  *)     printf 'SUMMARY BEGIN\n- checked the collision path\nSUMMARY END\nLooks sound.\nVERDICT: AGREED\n' > "$out" ;;
esac
exit 0
