{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v bash >/dev/null 2>&1 && bash \"${CLAUDE_PLUGIN_ROOT}/hooks/plan-sparring.sh\" || exit 0",
            "commandWindows": "exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/plan-sparring.sh\"",
            "commandWindows": "exit 0",
            "timeout": 20,
            "statusMessage": "Checking the sparring receipt..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|AskUserQuestion|EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/plan-sparring.sh\"",
            "commandWindows": "exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v bash >/dev/null 2>&1 && bash \"${CLAUDE_PLUGIN_ROOT}/hooks/plan-sparring.sh\" || exit 0",
            "commandWindows": "exit 0"
          }
        ]
      }
    ]
  }
}
